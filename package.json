{
  "name": "opentierboy",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run prepare-images && next dev",
    "prebuild": "node scripts/prepareImages.js --copy && npm run check:images -- --files",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepare-images": "node scripts/prepareImages.js",
