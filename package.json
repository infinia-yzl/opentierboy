    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "check": "tsc --noEmit -p . && eslint . && vitest run && npm run check:images && npm run check:fixtures && node scripts/generate-legacy-fixtures.mjs --check"
  },
