# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# downloads made by checks (scripts/check-trusted-sites.mjs)
/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# public/images: scripts/prepareImages.js copies or symlinks the official image sets here.
# The legacy sets are frozen: their WebP images are committed (imageset.legacy.json).
# prepareImages makes the PNG copies for link previews of every set; they are never committed.
public/images/*
!public/images/.gitkeep
!public/images/image-set/
!public/images/image-wutheringwaves/
!public/images/image-webdev/
!public/images/image-supervive/
!public/images/image-helldivers2/
/public/images/**/*.png
# The preview-size copy of the placeholder tile (scripts/prepareImages.js).
/public/placeholder-image.preview.png
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
