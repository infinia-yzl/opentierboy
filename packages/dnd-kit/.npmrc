# Build tools for the dnd-kit fork (see docs/reference/drag-and-drop.md).
# No lockfile: this folder is not part of the app install, and the build output is checked
# byte for byte instead. "before" makes npm pick the same versions on every machine: the
# newest release of each package published before this date.
package-lock=false
before=2026-10-18T00:00:00.000Z
ignore-scripts=true
